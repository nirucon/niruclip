#!/bin/sh
# NIRUCLIP — small X11 screen/webcam capture orchestrator.
set -eu
VERSION=0.1.9
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/niruclip"
STATE="$STATE_DIR/session.json"
OUTDIR="${NIRUCLIP_OUTPUT:-$HOME/Videos}"
MODE=full; AUDIO=mic; WEBCAM=off; CORNER=bottom-right; PRESET=share; COUNTDOWN=3; OUTPUT=""; WEBCAM_SIZE=medium
usage(){ printf '%s\n' "Usage: niruclip --full|--region|--window|--webcam-only [options]" "       niruclip --stop|--status|--version"; }
if [ "${1:-}" = --stop ]; then
  [ -f "$STATE" ] || { echo 'niruclip: no active recording' >&2; exit 1; }
  pid=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("pid",0))' "$STATE" 2>/dev/null || echo 0)
  [ "${pid:-0}" -gt 0 ] 2>/dev/null || { echo 'niruclip: no active recording' >&2; exit 1; }
  kill -INT "$pid" 2>/dev/null || true
  i=0; while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 50 ]; do sleep 0.1; i=$((i+1)); done
  printf 'NIRUCLIP stop requested for pid %s\n' "$pid"; exit 0
fi
while [ "$#" -gt 0 ]; do
  case "$1" in
    --full) MODE=full;; --region) MODE=region;; --window) MODE=window;; --webcam-only) MODE=webcam-only;;
    --audio) shift; AUDIO=${1:?missing audio mode};;
    --webcam) shift; WEBCAM=${1:?missing webcam mode};;
    --corner) shift; CORNER=${1:?missing corner};;
    --webcam-size) shift; WEBCAM_SIZE=${1:?missing webcam size};;
    --preset) shift; PRESET=${1:?missing preset};;
    --countdown) shift; COUNTDOWN=${1:?missing countdown};;
    --output) shift; OUTPUT=${1:?missing output};;
    --status) [ -f "$STATE" ] && cat "$STATE" || echo '{"state":"idle"}'; exit 0;;
    --version) echo "NIRUCLIP $VERSION"; exit 0;;
    -h|--help) usage; exit 0;;
    *) echo "niruclip: unknown option: $1" >&2; usage >&2; exit 2;;
  esac
  shift
done
case "$AUDIO" in none|mic|desktop|both);; *) echo 'niruclip: audio must be none, mic, desktop or both' >&2; exit 2;; esac
case "$WEBCAM" in off|corner|only);; *) echo 'niruclip: webcam must be off, corner or only' >&2; exit 2;; esac
case "$CORNER" in top-left|top-right|bottom-left|bottom-right);; *) echo 'niruclip: invalid corner' >&2; exit 2;; esac
case "$WEBCAM_SIZE" in small|medium|large);; *) echo 'niruclip: webcam-size must be small, medium or large' >&2; exit 2;; esac
case "$PRESET" in share|small|quality);; *) echo 'niruclip: invalid preset' >&2; exit 2;; esac
case "$COUNTDOWN" in ''|*[!0-9]*) echo 'niruclip: countdown must be 0..10' >&2; exit 2;; esac
[ "$COUNTDOWN" -le 10 ] || { echo 'niruclip: countdown must be 0..10' >&2; exit 2; }
command -v ffmpeg >/dev/null || { echo 'niruclip: ffmpeg is missing' >&2; exit 1; }
mkdir -p "$STATE_DIR"
if [ -f "$STATE" ]; then
  oldpid=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("pid",0))' "$STATE" 2>/dev/null || echo 0)
  if [ "${oldpid:-0}" -gt 0 ] 2>/dev/null && kill -0 "$oldpid" 2>/dev/null; then echo 'niruclip: a recording is already active' >&2; exit 1; fi
fi
if [ "$WEBCAM" != off ] || [ "$MODE" = webcam-only ]; then
  camera=${NIRUCLIP_CAMERA:-/dev/video0}
  [ -c "$camera" ] || { echo "niruclip: camera $camera is unavailable" >&2; exit 1; }
fi
if [ "$MODE" = region ] || [ "$MODE" = window ]; then
  command -v slop >/dev/null || { echo 'niruclip: slop is required for region/window capture' >&2; exit 1; }
  geom=$(slop -f '%x %y %w %h' 2>/dev/null) || { echo 'niruclip: selection cancelled' >&2; exit 1; }
  set -- $geom; [ "$#" = 4 ] || exit 1; RX=$1; RY=$2; RW=$3; RH=$4
else
  RX=0; RY=0
  geometry=$(xrandr --current 2>/dev/null | awk '/ primary /{print $4; exit}')
  [ -n "$geometry" ] || geometry=$(xrandr --current 2>/dev/null | awk '/ connected /{print $3; exit}')
  RW=${geometry%%x*}; rest=${geometry#*x}; RH=${rest%%+*}
  case "$RW$RH" in ''|*[!0-9]*) echo 'niruclip: cannot determine X11 display size' >&2; exit 1;; esac
fi
if [ -n "$OUTPUT" ]; then
  case "$OUTPUT" in */) mkdir -p "$OUTPUT"; final="$OUTPUT/NIRUCLIP-$(date +%F_%H-%M-%S).mkv";; *) final=$OUTPUT;; esac
else final="$OUTDIR/NIRUCLIP-$(date +%F_%H-%M-%S).mkv"; fi
case "$final" in *.mkv) ;; *) final="$final.mkv";; esac
parent=$(dirname "$final"); [ -d "$parent" ] || { echo "niruclip: parent directory does not exist: $parent" >&2; exit 1; }
partial="${final%.mkv}.part.mkv"
case "$PRESET" in
  share) scale="scale=-2:1080:force_original_aspect_ratio=decrease,pad=ceil(iw/2)*2:ceil(ih/2)*2"; rate=30; crf=23;;
  small) scale="scale=-2:720:force_original_aspect_ratio=decrease,pad=ceil(iw/2)*2:ceil(ih/2)*2"; rate=30; crf=28;;
  quality) scale="scale=trunc(iw/2)*2:trunc(ih/2)*2"; rate=30; crf=20;;
esac
[ "$COUNTDOWN" -gt 0 ] && { i=$COUNTDOWN; while [ "$i" -gt 0 ]; do printf 'NIRUCLIP recording in %s…\n' "$i"; sleep 1; i=$((i-1)); done; }
args="-hide_banner -loglevel warning -y"
inputs=""; filter=""; map=""
audio_idx=1
if [ "$MODE" = webcam-only ] || [ "$WEBCAM" = only ]; then
  inputs="-f v4l2 -i ${NIRUCLIP_CAMERA:-/dev/video0}"; map="-map 0:v:0"; audio_idx=1
elif [ "$WEBCAM" = corner ]; then
  inputs="-f x11grab -framerate $rate -video_size ${RW}x${RH} -i :0.0+$RX,$RY -f v4l2 -i ${NIRUCLIP_CAMERA:-/dev/video0}"
  case "$CORNER" in top-left) ox=16; oy=16;; top-right) ox="main_w-overlay_w-16"; oy=16;; bottom-left) ox=16; oy="main_h-overlay_h-16";; *) ox="main_w-overlay_w-16"; oy="main_h-overlay_h-16";; esac
  case "$WEBCAM_SIZE" in small) webcam_scale=0.20;; medium) webcam_scale=0.30;; large) webcam_scale=0.40;; esac
  filter="[0:v]${scale}[base];[1:v]scale=iw*$webcam_scale:-2[wc];[base][wc]overlay=$ox:$oy[v]"; map="-map [v]"; audio_idx=2
else
  inputs="-f x11grab -framerate $rate -video_size ${RW}x${RH} -i :0.0+$RX,$RY"; map="-map 0:v:0"; audio_idx=1
fi
case "$AUDIO" in
  none) ;;
  mic) inputs="$inputs -f pulse -i @DEFAULT_SOURCE@"; map="$map -map $audio_idx:a:0";;
  desktop) inputs="$inputs -f pulse -i @DEFAULT_MONITOR@"; map="$map -map $audio_idx:a:0";;
  both)
    inputs="$inputs -f pulse -i @DEFAULT_SOURCE@ -f pulse -i @DEFAULT_MONITOR@"
    filter="${filter:+$filter;}[$audio_idx:a][$((audio_idx+1)):a]amix=inputs=2:normalize=0[a]"
    map="$map -map [a]";;
esac
if [ -n "$filter" ]; then
  args="$args -filter_complex $filter"
elif [ "$WEBCAM" != corner ]; then
  args="$args -vf $scale"
fi
cmd="ffmpeg $args $inputs -c:v libx264 -preset veryfast -crf $crf -r $rate $map -c:a aac -b:a 160k $partial"
printf '%s' "$(python3 -c 'import json,sys,time; print(json.dumps({"state":"recording","pid":0,"started":time.time(),"output":sys.argv[1],"partial":sys.argv[2],"mode":sys.argv[3],"preset":sys.argv[4],"audio":sys.argv[5],"webcam":sys.argv[6]}))' "$final" "$partial" "$MODE" "$PRESET" "$AUDIO" "$WEBCAM")" > "$STATE"
# shellcheck disable=SC2086
$cmd & pid=$!
python3 - "$STATE" "$pid" <<'PY'
import json,sys
p,pid=sys.argv[1],int(sys.argv[2]); d=json.load(open(p)); d['pid']=pid; open(p,'w').write(json.dumps(d))
PY
printf 'NIRUCLIP recording: %s\n' "$final"
if wait "$pid"; then rc=0; else rc=$?; fi
case "$rc" in 0|129|130|143|255) if [ -f "$partial" ]; then mv "$partial" "$final"; state=finished; else state=failed; fi;; *) state=failed;; esac
printf '%s' "$(python3 -c 'import json,sys,time; print(json.dumps({"state":sys.argv[1],"pid":0,"output":sys.argv[2],"partial":sys.argv[3],"mode":sys.argv[4],"preset":sys.argv[5],"audio":sys.argv[6],"webcam":sys.argv[7]}))' "$state" "$final" "$partial" "$MODE" "$PRESET" "$AUDIO" "$WEBCAM")" > "$STATE"
[ "$state" = failed ] && printf 'NIRUCLIP: ffmpeg failed; partial retained at %s\n' "$partial" >&2 || :
exit "$rc"
